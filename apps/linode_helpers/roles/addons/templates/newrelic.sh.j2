#!/bin/bash
LOG_FILE="/var/log/newrelicpostinstall.log"
CONFIG_FILE="/etc/newrelic-infra.yml"

echo "=================================================" | tee -a "$LOG_FILE"
echo " New Relic Installation - License Key Setup" | tee -a "$LOG_FILE"
echo "=================================================" | tee -a "$LOG_FILE"
echo ""

read -rp "Enter your New Relic license key: " NEWRELIC_KEY
echo "If you don't have one, visit:" | tee -a "$LOG_FILE"
echo "  https://one.newrelic.com/admin-portal/api-keys/ to generate a new one" | tee -a "$LOG_FILE"
echo ""

if [ -n "$NEWRELIC_KEY" ]; then
  cat <<EOF > "$CONFIG_FILE"
license_key: $NEWRELIC_KEY
EOF
  chmod 600 "$CONFIG_FILE"
  chown root:root "$CONFIG_FILE"
  echo "$(date) - License key written to $CONFIG_FILE" | tee -a "$LOG_FILE"
else
  echo "$(date) - No key entered, skipping configuration." | tee -a "$LOG_FILE"
fi