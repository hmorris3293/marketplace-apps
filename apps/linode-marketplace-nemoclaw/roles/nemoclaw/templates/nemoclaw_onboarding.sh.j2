#!/usr/bin/env bash

if [ "$EUID" -ne 0 ]; then
    return
fi

NEMOCLAW_UID=$(id -u {{ nemoclaw_user }})
export XDG_RUNTIME_DIR="/run/user/$NEMOCLAW_UID"
export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
export CHAT_UI_URL="https://{{ _domain }}"
export NEMOCLAW_DASHBOARD_BIND="0.0.0.0"

NEMOCLAW_REGISTRY_FILE="{{ nemoclaw_home }}/.nemoclaw/sandboxes.json"
NEMOCLAW_AGENT_ROUTES_FILE="/etc/nginx/conf.d/nemoclaw_agent_routes.conf"

detect_selected_agent() {
	if [ ! -f "$NEMOCLAW_REGISTRY_FILE" ]; then
		return 1
	fi

	# Compact JSON and extract the first "agent":"..." token.
	# On fresh onboarding there is a single sandbox entry, so first match is the
	# selected runtime.
	local compact_json
	compact_json="$(tr -d '\n\r\t ' < "$NEMOCLAW_REGISTRY_FILE")"

	local agent
	agent="$(printf '%s' "$compact_json" | grep -o '"agent":"[^"]*"' | head -n1 | cut -d'"' -f4)"

	if [ -z "$agent" ]; then
		return 1
	fi

	echo "$agent"
}

apply_nginx_routes_for_agent() {
	local agent="$1"

	case "$agent" in
		hermes)
			cat > "$NEMOCLAW_AGENT_ROUTES_FILE" <<'EOF'
# Managed by /etc/profile.d/nemoclaw_onboarding.sh
# Hermes exposes an OpenAI-compatible API on /v1 via port {{ nemoclaw_hermes_api_port }}.
location ^~ /v1/ {
    proxy_pass http://127.0.0.1:{{ nemoclaw_hermes_api_port }}/v1/;
    proxy_http_version 1.1;

    proxy_set_header Host $host:{{ nemoclaw_hermes_api_port }};
    proxy_set_header X-Forwarded-Host $host:{{ nemoclaw_hermes_api_port }};
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 600s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
}
EOF
			;;
		langchain-deepagents-code)
			cat > "$NEMOCLAW_AGENT_ROUTES_FILE" <<'EOF'
# Managed by /etc/profile.d/nemoclaw_onboarding.sh
# LangChain Deep Agents Code has no dashboard to reverse proxy.
location = / {
    default_type text/plain;
    return 200 "LangChain Deep Agents Code has no web dashboard. Use SSH and run dcode/nemo-deepagents commands.\n";
}
EOF
			;;
		*)
			# openclaw and any unrecognized future agents use the base / location block.
			cat > "$NEMOCLAW_AGENT_ROUTES_FILE" <<'EOF'
# Managed by /etc/profile.d/nemoclaw_onboarding.sh
# No additional agent-specific nginx routes required.
EOF
			;;
	esac

	if nginx -t >/dev/null 2>&1; then
		systemctl reload nginx
		echo "[***] Applied nginx route profile for agent: $agent"
	else
		echo "[***] nginx config test failed after agent route update; keeping prior running config."
	fi
}

while true; do
	echo ""
	echo "[NemoClaw Onboarding]"
	read -rp "Do you want to run the nemoclaw onboard wizard? [y/n]: " answer

	if [[ "$answer" =~ ^[Yy]$ ]]; then
		echo "[***] Running onboarding as {{ nemoclaw_user }} user."
		echo "[***] Using CHAT_UI_URL=${CHAT_UI_URL}"
		echo "[***] Using NEMOCLAW_DASHBOARD_BIND=${NEMOCLAW_DASHBOARD_BIND}"
		if [ ! -S "${XDG_RUNTIME_DIR}/bus" ]; then
			echo "[***] systemd user bus not ready at ${XDG_RUNTIME_DIR}/bus."
			echo "[***] Try again in a few seconds, or run: systemctl start user@${NEMOCLAW_UID}.service"
			break
		fi
		runuser -u {{ nemoclaw_user }} -- env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" CHAT_UI_URL="$CHAT_UI_URL" NEMOCLAW_DASHBOARD_BIND="$NEMOCLAW_DASHBOARD_BIND" nemoclaw onboard
		onboard_rc=$?

		if [ "$onboard_rc" -eq 0 ]; then
			echo "[***] Initial onboarding complete. Removing {{ nemoclaw_onboarding_script }}."

			selected_agent="$(detect_selected_agent 2>/dev/null || true)"
			if [ -n "$selected_agent" ]; then
				apply_nginx_routes_for_agent "$selected_agent"
			else
				echo "[***] Could not detect selected agent from $NEMOCLAW_REGISTRY_FILE; keeping default nginx routes."
			fi

			if [ -f '{{ nemoclaw_onboarding_script }}' ]; then
				rm {{ nemoclaw_onboarding_script }}
			fi
		else
			echo "[***] Onboarding exited with status $onboard_rc. Try Onboarding again by logging in."
		fi
		break
	elif [[ "$answer" =~ ^[Nn]$ ]]; then
		echo "[***] Skipping NemoClaw onboarding."
		while true; do
			read -rp "[***] Do you want to remove the onboard script? [y/n]: " remove_script
			if [[ "$remove_script" =~ ^[Yy]$ ]]; then
				echo "[***] Removing {{ nemoclaw_onboarding_script }}"
				if [ -f '{{ nemoclaw_onboarding_script }}' ]; then
					rm {{ nemoclaw_onboarding_script }}
				fi
				break
			elif [[ "$remove_script" =~ ^[Nn]$ ]]; then
				echo "[***] Not removing onboarding script. This script will run again on next login."
				break
			else
				echo -e "\n[***] Please answer y or n."
			fi
		done
		break
	else
		echo -e "\n[***] Please answer y or n."
	fi
done
