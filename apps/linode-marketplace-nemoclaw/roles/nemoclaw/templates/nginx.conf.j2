server {
    listen 80 default_server;
    server_name _;
    return 301 https://{{ _domain }}$request_uri;
}

server {
    listen 80;
    server_name {{ _domain }};

    location ^~ /v1/ {
        proxy_pass http://127.0.0.1:{{ nemoclaw_hermes_api_port }}/v1/;
        proxy_http_version 1.1;

        proxy_set_header Host $host:{{ nemoclaw_hermes_api_port }};
        proxy_set_header X-Forwarded-Host $host:{{ nemoclaw_hermes_api_port }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ nemoclaw_dashboard_port }};
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host:{{ nemoclaw_dashboard_port }};
        proxy_set_header X-Forwarded-Host $host:{{ nemoclaw_dashboard_port }};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 600s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }
}
