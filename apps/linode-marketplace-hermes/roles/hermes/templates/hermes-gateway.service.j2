[Unit]
Description=Hermes Agent Gateway Service
After=network.target

[Service]
Type=simple
User={{ hermes_user }}
WorkingDirectory={{ hermes_install_dir }}
Environment="PATH={{ hermes_home }}/bin:/usr/local/bin:/usr/bin:/bin"
Environment="HERMES_HOME={{ hermes_home }}"
Environment="UV_NO_CONFIG=1"
ExecStart={{ hermes_install_dir }}/venv/bin/hermes gateway
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target