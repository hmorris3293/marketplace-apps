upstream openfang {
    server {{ openfang_listen }};
}

server {
    listen 80;
    server_name {{ _domain }};

    location / {
        # Protect dashboard with basic auth (outer layer; the app keeps its own API auth)
        auth_basic "Restricted Access";
        auth_basic_user_file {{ openfang_htpasswd_file }};

        proxy_pass http://openfang;

        # Hide the app's own 401 challenge so it doesn't re-trigger the browser
        # basic-auth prompt (would otherwise loop the outer login forever).
        proxy_hide_header WWW-Authenticate;

        # Set necessary headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Enable WebSocket connections
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Extend timeouts for long agent responses
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /health {
        proxy_pass http://openfang;
        access_log off;
    }
}
