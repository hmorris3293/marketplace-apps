# HTTP-only reverse proxy.
# Applied first so the app is reachable before (or without) a TLS certificate.
# nginx.yml swaps this for the SSL template once certbot obtains a certificate.
server {
    listen 80;
    server_name {{ openfang_domain }};

    access_log /var/log/nginx/openfang_access.log;
    error_log /var/log/nginx/openfang_error.log;

    proxy_buffering off;
    proxy_request_buffering off;

    location / {
        proxy_pass http://{{ openfang_api_listen }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /health {
        proxy_pass http://{{ openfang_api_listen }};
        access_log off;
    }
}
