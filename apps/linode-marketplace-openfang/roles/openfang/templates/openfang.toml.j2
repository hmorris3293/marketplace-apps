# OpenFang Configuration File
# Generated by marketplace deployment

# API Configuration
# Bind to loopback only; public access is proxied through NGINX (see nginx.yml).
api_key = "{{ openfang_api_key }}"
api_listen = "{{ openfang_listen }}"

# Default Language Model Configuration
[default_model]
provider = "{{ openfang_default_provider }}"
model = "{{ openfang_default_model }}"
api_key_env = "OPENAI_API_KEY"

# Memory and Database Configuration
[memory]
decay_rate = 0.05
sqlite_path = "openfang.db"
enable_vector_search = true

# Network Configuration
[network]
listen_addr = "127.0.0.1:{{ openfang_api_port }}"
enable_p2p = false

# Session Compaction
[compaction]
threshold = 100
keep_recent = 20
max_summary_tokens = 1024

# Channel Adapters (optional - enable as needed)
# Examples:

# [telegram]
# bot_token_env = "TELEGRAM_BOT_TOKEN"
# allowed_users = []

# [discord]
# bot_token_env = "DISCORD_BOT_TOKEN"
# guild_ids = []

# [slack]
# bot_token_env = "SLACK_BOT_TOKEN"
# app_token_env = "SLACK_APP_TOKEN"
