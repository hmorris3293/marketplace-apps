#!/usr/bin/env bash

# OpenFang first-login onboarding.
#
# Prompts for the default LLM provider/model/API key, writes them into the
# OpenFang config ({{ openfang_config_path }}) and the provider key into the
# OpenFang env file ({{ openfang_env_file }}), restarts OpenFang, then removes
# itself.

if [ "$EUID" -ne 0 ]; then
    return
fi

CONFIG_FILE="{{ openfang_config_path }}"
ENV_FILE="{{ openfang_env_file }}"
ONBOARDING_SCRIPT="{{ openfang_onboarding_script }}"

while true; do
    echo ""
    echo "[OpenFang Onboarding]"
    read -rp "Do you want to configure the default LLM provider now? [y/n]: " answer

    if [[ "$answer" =~ ^[Yy]$ ]]; then
        read -rp "LLM provider (e.g. openai, anthropic, gemini, groq, deepseek): " provider
        read -rp "Model name (e.g. gpt-4-turbo): " model

        default_env="$(echo "$provider" | tr '[:lower:]' '[:upper:]')_API_KEY"
        read -rp "Environment variable for the API key [${default_env}]: " api_key_env
        api_key_env="${api_key_env:-$default_env}"

        read -rsp "API key value (input hidden): " api_key
        echo ""

        if [ -z "$provider" ] || [ -z "$model" ] || [ -z "$api_key" ]; then
            echo "[***] Provider, model, and API key are all required. Try again."
            continue
        fi

        # Rewrite the three keys inside the [default_model] section only.
        tmp_file="$(mktemp)"
        awk -v provider="$provider" -v model="$model" -v env="$api_key_env" '
            /^\[default_model\]/ { in_section = 1; print; next }
            /^\[/ && !/^\[default_model\]/ { in_section = 0 }
            in_section && /^[[:space:]]*provider[[:space:]]*=/ { print "provider = \"" provider "\""; next }
            in_section && /^[[:space:]]*model[[:space:]]*=/ { print "model = \"" model "\""; next }
            in_section && /^[[:space:]]*api_key_env[[:space:]]*=/ { print "api_key_env = \"" env "\""; next }
            { print }
        ' "$CONFIG_FILE" > "$tmp_file" && mv "$tmp_file" "$CONFIG_FILE"
        chown {{ username }}:{{ username }} "$CONFIG_FILE"
        chmod 0600 "$CONFIG_FILE"

        # Store the API key value in the OpenFang env file.
        touch "$ENV_FILE"
        chown {{ username }}:{{ username }} "$ENV_FILE"
        chmod 0600 "$ENV_FILE"
        if grep -q "^${api_key_env}=" "$ENV_FILE"; then
            sed -i "s|^${api_key_env}=.*|${api_key_env}=${api_key}|" "$ENV_FILE"
        else
            echo "${api_key_env}=${api_key}" >> "$ENV_FILE"
        fi

        echo "[***] Restarting OpenFang service..."
        systemctl restart openfang

        echo "[***] LLM provider configured. Removing onboarding script."
        [ -f "$ONBOARDING_SCRIPT" ] && rm -f "$ONBOARDING_SCRIPT"
        break
    elif [[ "$answer" =~ ^[Nn]$ ]]; then
        echo "[***] Skipping OpenFang onboarding."
        while true; do
            read -rp "[***] Remove the onboarding script (won't prompt again)? [y/n]: " remove_script
            if [[ "$remove_script" =~ ^[Yy]$ ]]; then
                [ -f "$ONBOARDING_SCRIPT" ] && rm -f "$ONBOARDING_SCRIPT"
                break
            elif [[ "$remove_script" =~ ^[Nn]$ ]]; then
                echo "[***] Keeping the script. It will run again on next login."
                break
            else
                echo -e "\n[***] Please answer y or n."
            fi
        done
        break
    else
        echo -e "\n[***] Please answer y or n."
    fi
done
