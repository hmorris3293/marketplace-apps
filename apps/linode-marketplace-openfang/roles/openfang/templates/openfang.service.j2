[Unit]
Description=OpenFang Agent Operating System
Documentation=https://openfang.sh/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ username }}
Group={{ username }}
WorkingDirectory={{ openfang_home }}
EnvironmentFile=-{{ openfang_env_file }}
ExecStart={{ openfang_bin_path }}/openfang start
ExecReload=/bin/kill -HUP $MAINPID
KillMode=on-abort
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openfang

[Install]
WantedBy=multi-user.target
