# OpenFang environment for interactive shells.
# OPENFANG_HOME pins the deployment's home for any user (including root) so
# `openfang doctor` and other commands find the same directory, config, and
# .env that the openfang service uses. Also puts the binary on PATH.
export OPENFANG_HOME="{{ openfang_home }}"
export PATH="{{ openfang_bin_path }}:$PATH"
